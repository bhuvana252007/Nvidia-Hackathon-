# VerifyFirst AI — Student AI Tutor & Assistant Configuration
# Out-of-the-box autonomous mode works with zero API keys required.
# Live Nebius Token Factory and Tavily keys can be configured below or via the Settings modal in UI.

APP_URL="http://localhost:3000"
PORT=3000

# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=""
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"

# NVIDIA Nemotron Models
# Largest, smartest model for tutoring, math, physics, coding, and answers
NVIDIA_PRIMARY_MODEL="nvidia/llama-3.1-nemotron-70b-instruct-hf"
# Fast model for claim decomposition and verification checks
NVIDIA_FAST_MODEL="mistralai/Mistral-Nemo-Instruct-2407"

# Web Search Provider (Optional)
TAVILY_API_KEY=""
